<?xml version="1.0" encoding="utf-8"?>
<!--
    Dimension overrides for sw600dp tablets in PORTRAIT.
    Larger screens get bigger text and more generous spacing.
-->
<resources>
    <!-- Screen padding -->
    <dimen name="screen_padding">16dp</dimen>

    <!-- Amount display -->
    <dimen name="amount_label_size">28sp</dimen>
    <dimen name="amount_value_size">40sp</dimen>
    <dimen name="amount_padding_end">16dp</dimen>

    <!-- Dividers -->
    <dimen name="divider_height">1dp</dimen>
    <dimen name="divider_margin_top">8dp</dimen>

    <!-- Change table -->
    <dimen name="table_header_size">18sp</dimen>
    <dimen name="table_header_padding_v">8dp</dimen>
    <dimen name="table_row_text_size">20sp</dimen>

    <!-- Keypad buttons -->
    <dimen name="keypad_text_size">26sp</dimen>
    <dimen name="keypad_clear_text_size">20sp</dimen>
    <dimen name="btn_margin">6dp</dimen>
</resources>
